generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Guild {
  id                    String            @id
  confessionChannel     String?
  countingChannel       String?
  countingCurrent       Int               @default(0)
  countingLastUser      String?
  countingHighScore     Int               @default(0)
  logChannelId          String?
  autoroleId            String?
  welcomeChannelId      String?
  welcomeMessage        String?
  welcomeCardEnabled    Boolean           @default(true)
  welcomeCardBackground String?
  welcomeCardColor      String?           @default("#38bdf8")
  welcomeCardFont       String?           @default("Exo2")
  welcomeCardStyle      String?           @default("glass")
  welcomeCardTitle      String?
  joinDmMessage         String?
  giveawayDefaultRoleId  String?
  giveawayDefaultInvites Int?      @default(0)
  giveawayBypassRoleId   String?
  verificationChannelId String?
  verificationRoleId    String?
  unverifiedRoleId      String?
  verificationSilentRoleEnabled Boolean           @default(false)
  verificationSilentRoleId      String?
  verificationType      String            @default("NORMAL")
  verificationLogChannelId String?
  verificationMessage   String?
  verificationTitle     String?
  verificationEmbedData String?
  verificationEnabled   Boolean           @default(false)
  vanityString          String?
  vanityRoleId          String?
  birthdayChannelId     String?
  birthdayPingRoleId    String?
  levelChannelId        String?
  prefix                String            @default("e!")
  suggestionChannelId   String?
  antiNukeEnabled       Boolean           @default(false)
  antiNukeBan           Boolean           @default(false)
  antiNukeKick          Boolean           @default(false)
  antiNukeChannel       Boolean           @default(false)
  antiNukeRole          Boolean           @default(false)
  antiNukeBot           Boolean           @default(false)
  antiNukeWebhook       Boolean           @default(false)
  logMessagesEnabled    Boolean           @default(true)
  logChannelsEnabled    Boolean           @default(true)
  logRolesEnabled       Boolean           @default(true)
  logMembersEnabled     Boolean           @default(true)
  logModerationEnabled  Boolean           @default(true)
  logSecurityEnabled    Boolean           @default(true)
  logVoiceEnabled       Boolean           @default(true)
  logAutomodEnabled     Boolean           @default(true)
  logBotEnabled         Boolean           @default(true)
  logInvitesEnabled     Boolean           @default(true)
  logEmojiEnabled       Boolean           @default(true)
  logStickerEnabled     Boolean           @default(true)
  logEventsEnabled      Boolean           @default(true)
  logStageEnabled       Boolean           @default(true)
  logServerEnabled      Boolean           @default(true)
  logThreadsEnabled     Boolean           @default(true)
  logVanityEnabled      Boolean           @default(true)
  logWebhooksEnabled    Boolean           @default(true)
  logChannelMessages    String?
  logChannelChannels    String?
  logChannelRoles       String?
  logChannelMembers     String?
  logChannelModeration  String?
  logChannelSecurity    String?
  logChannelVoice       String?
  logChannelAutomod     String?
  logChannelBot         String?
  logChannelInvites     String?
  logChannelEmoji       String?
  logChannelSticker     String?
  logChannelEvents      String?
  logChannelStage       String?
  logChannelServer      String?
  logChannelThreads     String?
  logChannelVanity      String?
  logChannelWebhooks    String?
  logMode               String            @default("CORE")
  logCategoryId         String?
  music_language        String?           @default("en-US")
  defaultVolume         Int?              @default(100)
  djMode                Boolean?          @default(false)
  setupChannel          String?
  setupMessage          String?
  stay247               Boolean?          @default(false)
  stay247TextChannel    String?
  stay247VoiceChannel   String?
  aiPersonality         String?           @default("CASUAL")
  aiCustomPrompt        String?
  aiSearchEnabled       Boolean           @default(true)
  aiEnabled             Boolean           @default(true)
  greeterChannelId      String?
  greeterMessage        String?
  greeterTime           Int?
  starboardChannelId    String?
  starboardCount        Int?
  snipeEnabled          Boolean           @default(true)
  backroomRoleId        String?
  backroomChannelId     String?
  lockdownEnabled       Boolean           @default(false)
  lockdownMode          String            @default("PUBLIC")
  lockdownChannels      String?
  lockdownRoles         String?
  autoModEnabled        Boolean           @default(false)
  botNickname           String?
  botBio                String?
  botAvatar             String? 
  botBanner             String?
  lastBrandingUpdate    DateTime?
  leaveChannelId        String?
  leaveMessage          String?
  levelingEnabled       Boolean           @default(true)
  xpFormulaCurve        String            @default("LINEAR")
  xpFormulaMultiplier   Float             @default(1.0)
  xpFormulaMaxLevel     Int?
  xpMessageEnabled      Boolean           @default(true)
  xpMessageMode         String            @default("RANDOM")
  xpMessageMin          Int               @default(15)
  xpMessageMax          Int               @default(25)
  xpMessageCooldown     Int               @default(60)
  xpVoiceEnabled        Boolean           @default(false)
  xpVoiceMin            Int               @default(15)
  xpVoiceMax            Int               @default(40)
  xpVoiceCooldown       Int               @default(180)
  xpVoiceMinMembers     Int               @default(2)
  xpVoiceAntiAfk        Boolean           @default(true)
  xpReactionEnabled     Boolean           @default(false)
  xpReactionAwardType   String            @default("BOTH")
  xpReactionMin         Int               @default(5)
  xpReactionMax         Int               @default(10)
  xpReactionCooldown    Int               @default(300)
  levelUpMessageEnabled Boolean           @default(true)
  levelUpMessage        String?           @default("GG {user.mention}, you just reached level **{user.level}**!")
  levelUpImageEnabled   Boolean           @default(false)
  levelUpChannelId      String?
  rankCardChannelId     String?
  levelUpEmbedData      String?
  firstPlaceRoleId      String?
  stackRoleRewards      Boolean           @default(true)
  stackXpBoosters       Boolean           @default(true)
  voteRewardEnabled     Boolean           @default(false)
  effortBoosterEnabled  Boolean           @default(false)
  effortBoosterWords    Int               @default(25)
  effortBoosterImages   Int               @default(3)
  effortBoosterPercentage Int             @default(10)
  weeklyHighlightsEnabled Boolean         @default(false)
  weeklyHighlightsChannelId String?
  monthlyHighlightsEnabled Boolean        @default(false)
  monthlyHighlightsChannelId String?
  rankCardProgressColor String?           @default("#ffffff")
  rankCardProgressOpacity Float?          @default(1.0)
  rankCardBackgroundColor String?         @default("#000000")
  rankCardFontColor     String?           @default("#ffffff")
  rankCardBackgroundUrl String?
  disableXpCommand      Boolean           @default(false)
  disableLeaderboardReset Boolean         @default(false)
  auditLogs             AuditLog[]        @relation("GuildToAuditLog")
  autoResponses         AutoResponse[]
  djRoles               DjRole[]
  extraOwners           ExtraOwner[]
  giveaways             Giveaway[]
  ignoredChannels       IgnoredChannel[]
  playlists             Playlist[]
  reactionRoles         ReactionRole[]
  stickyMessages        StickyMessage[]
  suggestions           Suggestion[]
  whitelistedRoles      WhitelistedRole[]
  whitelistedUsers      WhitelistedUser[]
  trustedUsers          TrustedUser[]
  permits               Permit[]
  autoModFilters        AutoModFilter[]
  autoModWhitelists     AutoModWhitelist[]
  antiNukeConfig        AntiNukeConfig?
  giveawayBlacklists    GiveawayBlacklist[]
  giveawayBonusEntries  GiveawayBonusEntry[]
  starboardMessages     StarboardMessage[]
  levelRoles            LevelRole[]
  tickets               Ticket[]
  ticketConfigs         TicketConfig[]
  voiceConfig           VoiceConfig?
  roleBoosters          RoleBooster[]
  channelBoosters       ChannelBooster[]
  roleConnections       RoleConnection[]
  appeals               Appeal[]
  streakTiers           StreakTier[]
  userStreaks           UserStreak[]
  userDailyActivities   UserDailyActivity[]
  commandAliases        CommandAlias[]
  channelDailyActivities ChannelDailyActivity[]
  reactionDailyActivities ReactionDailyActivity[]
  voiceDailyActivities   VoiceDailyActivity[]
  streaksEnabled        Boolean           @default(true)
  streakChannelId       String?
  streakMessageMode     String            @default("TEXT")
  autoReacts            AutoReact[]
  reactLocks            ReactLock[]
  uwuLocks              UwuLock[]
  forcedNicknames       ForcedNickname[]
  assets               Asset[]
  roleRules            RoleRule[]
}

model CommandAlias {
  id          Int      @id @default(autoincrement())
  guildId     String
  alias       String
  commandName String
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, alias])
}

model Appeal {
  id            Int      @id @default(autoincrement())
  guildId       String
  userId        String
  userTag       String
  type          String   // BAN, KICK, MUTE
  reason        String   // Reason for punishment
  appealReason  String   // User's explanation
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED
  staffId       String?
  staffReason   String?  // Reason for approval/rejection
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  guild         Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, status])
}

model UserConfig {
  userId        String    @id
  snipeOptOut   Boolean   @default(false)
  timezone      String?
  nsfwConsent   Boolean   @default(false)
  nsfwConsentAt DateTime?
}

model TimezoneSession {
  id        String   @id
  userId    String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model GiveawayBlacklist {
  id      Int    @id @default(autoincrement())
  guildId String
  userId  String
  guild   Guild  @relation(fields: [guildId], references: [id])

  @@unique([guildId, userId])
}

model GiveawayBonusEntry {
  id       Int    @id @default(autoincrement())
  guildId  String
  targetId String
  type     String // ROLE, USER
  entries  Int    @default(1)
  guild    Guild  @relation(fields: [guildId], references: [id])

  @@unique([guildId, targetId])
}

model StarboardMessage {
  id                 Int    @id @default(autoincrement())
  guildId            String
  originalMessageId  String @unique
  starboardMessageId String @unique
  starCount          Int    @default(0)
  guild              Guild  @relation(fields: [guildId], references: [id])
}

model TrustedUser {
  id      Int    @id @default(autoincrement())
  guildId String
  userId  String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId])
}

model ExtraOwner {
  id      Int    @id @default(autoincrement())
  guildId String
  userId  String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId])
}

model WhitelistedUser {
  id      Int    @id @default(autoincrement())
  guildId String
  userId  String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId])
}

model WhitelistedRole {
  id      Int    @id @default(autoincrement())
  guildId String
  roleId  String
  guild   Guild  @relation(fields: [guildId], references: [id])

  @@unique([guildId, roleId])
}

model StickyMessage {
  id        Int     @id @default(autoincrement())
  guildId   String
  channelId String
  content   String
  lastMsgId String?
  guild     Guild   @relation(fields: [guildId], references: [id])

  @@unique([guildId, channelId])
}

model Story {
  id        Int     @id @default(autoincrement())
  guildId   String
  channelId String
  content   String  @default("")
  isActive  Boolean @default(true)
  lastUser  String?

  @@unique([guildId, channelId])
}

model Member {
  id           Int    @id @default(autoincrement())
  guildId      String
  userId       String
  xp           Int    @default(0)
  level        Int    @default(0)
  messages     Int    @default(0)
  invites      Int    @default(0)
  lastUsername String?
  lastAvatar   String?

  @@unique([guildId, userId])
}

model Channel {
  id      String @id
  guildId String
  name    String
}

model IgnoredChannel {
  id        Int    @id @default(autoincrement())
  guildId   String
  channelId String
  guild     Guild  @relation(fields: [guildId], references: [id])
}

model AutoResponse {
  id        Int      @id @default(autoincrement())
  guildId   String
  trigger   String
  response  String
  channelId String?
  matchType String   @default("EXACT")
  guild     Guild    @relation(fields: [guildId], references: [id])
}

model ReactionRole {
  id        Int    @id @default(autoincrement())
  guildId   String
  messageId String
  emoji     String
  roleId    String
  guild     Guild  @relation(fields: [guildId], references: [id])
}

model Giveaway {
  id              Int             @id @default(autoincrement())
  guildId         String
  channelId       String
  messageId       String          @unique
  prize           String
  winnersCount    Int
  endTime         DateTime
  reqRoleId       String?
  reqInvites      Int             @default(0)
  reqMessageCount Int             @default(0)
  reqLevel        Int             @default(0)
  isActive        Boolean         @default(true)
  hostId          String
  guild           Guild           @relation(fields: [guildId], references: [id])
  entries         GiveawayEntry[]
}

model GiveawayEntry {
  id         Int      @id @default(autoincrement())
  giveawayId Int
  userId     String
  giveaway   Giveaway @relation(fields: [giveawayId], references: [id])

  @@unique([giveawayId, userId])
}

model Birthday {
  id      Int    @id @default(autoincrement())
  guildId String
  userId  String
  day     Int
  month   Int
  year    Int?

  @@unique([guildId, userId])
}

model CustomRole {
  id      Int    @id @default(autoincrement())
  guildId String
  userId  String
  roleId  String

  @@unique([guildId, userId])
}

model DjRole {
  id      Int    @id @default(autoincrement())
  guildId String
  roleId  String
  guild   Guild  @relation(fields: [guildId], references: [id])

  @@unique([guildId, roleId])
}

model Playlist {
  id      Int     @id @default(autoincrement())
  userId  String
  name    String
  guildId String?
  guild   Guild?  @relation(fields: [guildId], references: [id])
  tracks  Track[]

  @@unique([userId, name])
}

model Track {
  id         Int      @id @default(autoincrement())
  playlistId Int
  encoded    String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
}

model Confession {
  id        Int      @id @default(autoincrement())
  guildId   String
  number    Int
  userId    String
  userTag   String
  content   String
  createdAt DateTime @default(now())

  @@unique([guildId, number])
}

model Afk {
  id        Int          @id @default(autoincrement())
  userId    String       @unique
  reason    String       @default("AFK")
  timestamp DateTime     @default(now())
  mentions  AfkMention[]
}

model AfkMention {
  id        Int      @id @default(autoincrement())
  afkId     Int
  userId    String
  userTag   String
  guildId   String
  channelId String
  messageId String
  createdAt DateTime @default(now())
  afk       Afk      @relation(fields: [afkId], references: [id], onDelete: Cascade)
}

model TicketConfig {
  id                    Int     @id @default(autoincrement())
  guildId               String
  guild                 Guild   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  panelId               String
  name                  String
  description           String  @default("Click the button below to open a ticket.")
  categoryId            String?
  supportRoleId         String?
  channelId             String?
  messageId             String?
  welcomeMessage        String? @default("Hello {user}, welcome to your support ticket. Our staff will be with you shortly.")
  isMulti               Boolean @default(false)
  
  // New Fields for Single/Multi Panel properties
  mentionOnOpen         String? // Comma separated role IDs
  transcriptChannelId   String?
  useThreads            Boolean @default(false)
  notificationChannelId String?
  openCooldown          Int     @default(0)
  maxOpenTickets        Int     @default(1)
  hideCloseButton       Boolean @default(false)
  hideCloseReasonButton Boolean @default(false)
  hideClaimButton       Boolean @default(false)
  
  // Customization
  panelColor            String? @default("#9333ea")
  buttonColor           String? @default("PRIMARY")
  buttonText            String? @default("Create Ticket")
  buttonEmoji           String? @default("🎫")
  largeImageUrl         String?
  smallImageUrl         String?
  useV2                 Boolean @default(false)
  transcriptEnabled     Boolean @default(true)
  transcriptDM          Boolean @default(true)
  
  // Multi-panel specific
  useDropdown           Boolean @default(false)
  embedTitle            String?
  embedDescription      String?
  authorName            String?
  authorIcon            String?
  footerText            String?
  footerIcon            String?

  // Advanced Customization & Logic
  ticketNameFormat      String? @default("ticket-{id}")
  ticketCount           Int     @default(0)
  
  // Advanced Welcome Embed
  welcomeTitle          String?
  welcomeDescription    String?
  welcomeColor          String? @default("#9333ea")
  welcomeAuthorName     String?
  welcomeAuthorIcon     String?
  welcomeAuthorUrl      String?
  welcomeFooterText     String?
  welcomeFooterIcon     String?
  welcomeTimestamp      Boolean @default(false)
  welcomeFields         String? // Store as JSON string
  welcomeImage          String?
  welcomeThumbnail      String?

  options               TicketPanelOption[]

  @@unique([guildId, panelId])
}

model TicketPanelOption {
  id             Int     @id @default(autoincrement())
  panelId        Int
  optionId       String
  label          String
  categoryId     String?
  supportRoleId  String?
  emoji          String?
  description    String?
  
  // For multi-panels, this points to the target panelId string
  targetPanelId  String? 
  buttonColor    String  @default("PRIMARY")
  
  panel          TicketConfig @relation(fields: [panelId], references: [id], onDelete: Cascade)

  @@unique([panelId, optionId])
}

model Ticket {
  id         Int      @id @default(autoincrement())
  guildId    String
  guild      Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  channelId  String   @unique
  userId     String
  claimantId String?
  panelId    String?
  status     String   @default("OPEN")
  openedAt   DateTime @default(now())
  number     Int      @default(0)
}

model VoiceConfig {
  id              Int     @id @default(autoincrement())
  guildId         String  @unique
  guild           Guild   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  createChannelId String
  categoryId      String
  panelChannelId  String?
  panelMessageId  String?
}

model TempVoice {
  id        Int      @id @default(autoincrement())
  guildId   String
  channelId String   @unique
  ownerId   String
  isLocked  Boolean  @default(false)
  isHidden  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Suggestion {
  id          Int              @id @default(autoincrement())
  guildId     String
  messageId   String           @unique
  authorId    String
  content     String
  isAnonymous Boolean          @default(false)
  createdAt   DateTime         @default(now())
  guild       Guild            @relation(fields: [guildId], references: [id])
  votes       SuggestionVote[]
}

model SuggestionVote {
  id           Int        @id @default(autoincrement())
  suggestionId Int
  userId       String
  type         String
  suggestion   Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  @@unique([suggestionId, userId])
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  guildId     String
  type        String
  event       String
  status      String   @default("INFO")
  executorId  String?
  executorTag String?
  targetId    String?
  targetName  String?
  details     String?
  transcript  String?
  createdAt   DateTime @default(now())
  guild       Guild    @relation("GuildToAuditLog", fields: [guildId], references: [id])

  @@index([guildId, executorId, type])
}

model Permit {
  id          Int      @id @default(autoincrement())
  guildId     String
  targetId    String
  type        String   @default("USER") // USER, ROLE
  permissions String   @default("[]")   // JSON string of permissions
  immunity    Boolean  @default(false)
  guild       Guild    @relation(fields: [guildId], references: [id])

  @@unique([guildId, targetId])
}

model AutoModFilter {
  id          Int      @id @default(autoincrement())
  guildId     String
  type        String   // SPAM, MENTIONS, INVITES, LINKS, WORDS, MALICIOUS
  enabled     Boolean  @default(false)
  threshold   Int?
  action      String   @default("DELETE")
  data        String?
  guild       Guild    @relation(fields: [guildId], references: [id])

  @@unique([guildId, type])
}

model AutoModWhitelist {
  id        Int      @id @default(autoincrement())
  guildId   String
  targetId  String
  type      String   // USER, ROLE, CHANNEL, CATEGORY
  guild     Guild    @relation(fields: [guildId], references: [id])
}

model AntiNukeConfig {
  id              Int     @id @default(autoincrement())
  guildId         String  @unique
  banHeat         Int     @default(20)
  kickHeat        Int     @default(15)
  channelHeat     Int     @default(10)
  roleHeat        Int     @default(10)
  webhookHeat     Int     @default(25)
  decayRate       Int     @default(5)
  punishment      String  @default("STRIP_ROLES")
  guild           Guild   @relation(fields: [guildId], references: [id])
}

model LevelRole {
  id      Int    @id @default(autoincrement())
  guildId String
  level   Int
  roleId  String
  guild   Guild  @relation(fields: [guildId], references: [id])

  @@unique([guildId, level])
}

model RoleBooster {
  id         Int    @id @default(autoincrement())
  guildId    String
  roleId     String
  percentage Int
  guild      Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, roleId])
}

model ChannelBooster {
  id         Int    @id @default(autoincrement())
  guildId    String
  channelId  String
  percentage Int
  guild      Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, channelId])
}

model RoleConnection {
  id              Int      @id @default(autoincrement())
  guildId         String
  triggerRoleId   String
  connectedRoleId String
  guild           Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, triggerRoleId, connectedRoleId])
}

model RoleRule {
  id         Int      @id @default(autoincrement())
  guildId    String
  mainRoleId String
  mode       String   @default("OR") // "OR" | "AND"
  conditions Json     // Array of { type: "HAS" | "DOES_NOT_HAVE", roleId: string }
  action     String   @default("ASSIGN_OR_REMOVE") // "ASSIGN_OR_REMOVE" | "REMOVE_WHEN_MATCH"
  guild      Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, mainRoleId])
}

model StreakTier {
  id        Int      @id @default(autoincrement())
  guildId   String
  name      String
  threshold Int      // Messages needed per day
  message   String?  // Custom streak message template
  embedData String?  // JSON embed data for streak notifications
  imageUrl  String?  // Custom image card URL
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userStreaks UserStreak[]

  @@unique([guildId, threshold])
}

model UserStreak {
  id              Int        @id @default(autoincrement())
  guildId         String
  userId          String
  tierId          Int
  currentStreak   Int        @default(0)
  longestStreak   Int        @default(0)
  lastActiveDate  String     // YYYY-MM-DD
  tier            StreakTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  guild           Guild      @relation(fields: [guildId], references: [id], onDelete: Cascade)
  
  @@unique([guildId, userId, tierId])
}

model UserDailyActivity {
  id          Int      @id @default(autoincrement())
  guildId     String
  userId      String
  date        String   // YYYY-MM-DD
  messageCount Int     @default(0)
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId, date])
}

model ChannelDailyActivity {
  id          Int      @id @default(autoincrement())
  guildId     String
  channelId   String
  date        String   // YYYY-MM-DD
  messageCount Int     @default(0)
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, channelId, date])
}

model ReactionDailyActivity {
  id            Int      @id @default(autoincrement())
  guildId       String
  date          String   // YYYY-MM-DD
  reactionCount Int      @default(0)
  guild         Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, date])
}

model VoiceDailyActivity {
  id          Int      @id @default(autoincrement())
  guildId     String
  date        String   // YYYY-MM-DD
  seconds     Int      @default(0)
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, date])
}

model AutoReact {
  id        Int    @id @default(autoincrement())
  guildId   String
  trigger   String
  emoji     String
  guild     Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, trigger, emoji])
}

model ReactLock {
  id         Int    @id @default(autoincrement())
  guildId    String
  targetId   String
  targetType String // "user" or "role"
  emoji      String
  guild      Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, targetId, emoji])
}

model UwuLock {
  id       Int    @id @default(autoincrement())
  guildId  String
  userId   String
  lockType String @default("uwu") // "uwu", "nsfw", "mommy"
  guild    Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId])
}

model DevUser {
  id     Int    @id @default(autoincrement())
  userId String @unique
}

model DevMute {
  id        Int      @id @default(autoincrement())
  guildId   String
  userId    String
  reason    String   @default("No reason provided")
  expiresAt DateTime
  mutedBy   String

  @@unique([guildId, userId])
}

model ForcedNickname {
  id        Int    @id @default(autoincrement())
  guildId   String
  userId    String
  nickname  String
  guild     Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId])
}

model SocialAction {
  id        Int    @id @default(autoincrement())
  userId    String // Target user ID
  fromId    String // Sender user ID
  action    String // hug, kiss, etc.
  count     Int    @default(0)

  @@unique([userId, fromId, action])
  @@index([userId, action])
}

model SavedEmbed {
  id        Int      @id @default(autoincrement())
  guildId   String
  name      String
  tag       String
  data      String   // JSON string of embed data
  createdAt DateTime @default(now())

  @@unique([guildId, tag])
}

model ComponentAction {
  id        Int      @id @default(autoincrement())
  guildId   String
  customId  String
  logic     String   // JSON string of action logic
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, customId])
}

model Asset {
  id        String   @id @default(cuid())
  guildId   String
  name      String
  url       String
  type      String   @default("IMAGE") // IMAGE, ICON, EMOJI
  createdAt DateTime @default(now())
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
}

model Marriage {
  id          Int      @id @default(autoincrement())
  user1Id     String   @unique
  user2Id     String   @unique
  marriedAt   DateTime @default(now())
  ring        String?
  proposerId  String
}

model FamilyRelation {
  id        Int      @id @default(autoincrement())
  parentId  String
  childId   String

  @@unique([parentId, childId])
  @@index([parentId])
  @@index([childId])
}

model CustomReaction {
  id        Int      @id @default(autoincrement())
  action    String   // "suicide", "kill", etc.
  url       String   @unique
  createdAt DateTime @default(now())

  @@index([action])
}

model UserMention {
  id        Int      @id @default(autoincrement())
  guildId   String
  channelId String
  messageId String
  userId    String   // The user who WAS mentioned
  authorId  String   // The user who sent the mention
  authorTag String   // The tag of the user who sent the mention
  content   String   // Snippet of the message content
  isReply   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model DevLock {
  id         Int      @id @default(autoincrement())
  targetId   String   @unique
  targetType String   // "user" or "channel"
  lockType   String   // "uwu", "nsfw", "mommy", "react"
  emoji      String?  // Optional emoji for react lock
  createdAt  DateTime @default(now())
}

model DevAntiNuke {
  id        Int      @id @default(autoincrement())
  guildId   String   @unique
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Case {
  id           Int       @id @default(autoincrement())
  guildId      String
  caseNumber   Int
  type         String    // "WARN", "BAN", "KICK", "MUTE", "TIMEOUT", "UNBAN", "UNMUTE"
  targetId     String
  targetTag    String?
  moderatorId  String
  moderatorTag String?
  reason       String
  duration     String?
  removedRoles String?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([guildId, caseNumber])
  @@index([guildId, targetId])
  @@index([guildId, type])
  @@index([guildId, active])
}

model UserVote {
  userId        String    @id
  totalVotes    Int       @default(0)
  lastVotedAt   DateTime?
  remindMe      Boolean   @default(true)
  reminderSent  Boolean   @default(false)
  updatedAt     DateTime  @updatedAt
  createdAt     DateTime  @default(now())

  @@index([userId])
}

model VerificationSession {
  token        String    @id
  guildId      String
  userId       String
  userTag      String?
  expiresAt    DateTime
  used         Boolean   @default(false)
  ip           String?
  fingerprint  String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  @@index([token])
  @@index([guildId, userId])
}

model VerifiedDevice {
  id           String    @id @default(cuid())
  guildId      String
  userId       String
  userTag      String?
  ip           String
  fingerprint  String
  userAgent    String?
  isAlt        Boolean   @default(false)
  altOfUserId  String?
  altOfUserTag String?
  verifiedAt   DateTime  @default(now())

  @@index([guildId, userId])
  @@index([guildId, ip])
  @@index([guildId, fingerprint])
  @@index([fingerprint])
  @@index([ip])
}

model MachineBan {
  id           String    @id @default(cuid())
  guildId      String?
  userId       String?
  userTag      String?
  fingerprint  String
  ip           String?
  reason       String?
  bannedBy     String?
  createdAt    DateTime  @default(now())

  @@index([fingerprint])
  @@index([ip])
  @@index([guildId, fingerprint])
}



