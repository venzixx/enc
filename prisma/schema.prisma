generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Guild {
  id                    String            @id
  confessionChannel     String?
  countingChannel       String?
  countingCurrent       Int               @default(0)
  countingLastUser      String?
  countingHighScore     Int               @default(0)
  logChannelId          String?
  autoroleId            String?
  welcomeChannelId      String?
  welcomeMessage        String?
  joinDmMessage         String?
  giveawayDefaultRoleId  String?
  giveawayDefaultInvites Int?      @default(0)
  giveawayBypassRoleId   String?
  verificationChannelId String?
  verificationRoleId    String?
  verificationType      String            @default("BUTTON")
  vanityString          String?
  vanityRoleId          String?
  birthdayChannelId     String?
  birthdayPingRoleId    String?
  levelChannelId        String?
  prefix                String            @default("e!")
  suggestionChannelId   String?
  antiNukeEnabled       Boolean           @default(false)
  antiNukeBan           Boolean           @default(false)
  antiNukeKick          Boolean           @default(false)
  antiNukeChannel       Boolean           @default(false)
  antiNukeRole          Boolean           @default(false)
  antiNukeBot           Boolean           @default(false)
  antiNukeWebhook       Boolean           @default(false)
  logMessagesEnabled    Boolean           @default(true)
  logChannelsEnabled    Boolean           @default(true)
  logRolesEnabled       Boolean           @default(true)
  logMembersEnabled     Boolean           @default(true)
  logModerationEnabled  Boolean           @default(true)
  logSecurityEnabled    Boolean           @default(true)
  logVoiceEnabled       Boolean           @default(true)
  music_language        String?           @default("en-US")
  defaultVolume         Int?              @default(100)
  djMode                Boolean?          @default(false)
  setupChannel          String?
  setupMessage          String?
  stay247               Boolean?          @default(false)
  stay247TextChannel    String?
  stay247VoiceChannel   String?
  aiPersonality         String?           @default("CASUAL")
  aiCustomPrompt        String?
  aiSearchEnabled       Boolean           @default(true)
  greeterChannelId      String?
  greeterMessage        String?
  greeterTime           Int?
  starboardChannelId    String?
  starboardCount        Int?
  snipeEnabled          Boolean           @default(true)
  backroomRoleId        String?
  backroomChannelId     String?
  auditLogs             AuditLog[]        @relation("GuildToAuditLog")
  autoResponses         AutoResponse[]
  djRoles               DjRole[]
  extraOwners           ExtraOwner[]
  giveaways             Giveaway[]
  ignoredChannels       IgnoredChannel[]
  playlists             Playlist[]
  reactionRoles         ReactionRole[]
  stickyMessages        StickyMessage[]
  suggestions           Suggestion[]
  whitelistedRoles      WhitelistedRole[]
  whitelistedUsers      WhitelistedUser[]
}

model ExtraOwner {
  id      Int    @id @default(autoincrement())
  guildId String
  userId  String
  guild   Guild  @relation(fields: [guildId], references: [id])

  @@unique([guildId, userId])
}

model WhitelistedUser {
  id      Int    @id @default(autoincrement())
  guildId String
  userId  String
  guild   Guild  @relation(fields: [guildId], references: [id])

  @@unique([guildId, userId])
}

model WhitelistedRole {
  id      Int    @id @default(autoincrement())
  guildId String
  roleId  String
  guild   Guild  @relation(fields: [guildId], references: [id])

  @@unique([guildId, roleId])
}

model StickyMessage {
  id        Int     @id @default(autoincrement())
  guildId   String
  channelId String
  content   String
  lastMsgId String?
  guild     Guild   @relation(fields: [guildId], references: [id])

  @@unique([guildId, channelId])
}

model Story {
  id        Int     @id @default(autoincrement())
  guildId   String
  channelId String
  content   String  @default("")
  isActive  Boolean @default(true)
  lastUser  String?

  @@unique([guildId, channelId])
}

model Member {
  id       Int    @id @default(autoincrement())
  guildId  String
  userId   String
  xp       Int    @default(0)
  level    Int    @default(0)
  messages Int    @default(0)
  invites  Int    @default(0)

  @@unique([guildId, userId])
}

model IgnoredChannel {
  id        Int    @id @default(autoincrement())
  guildId   String
  channelId String
  guild     Guild  @relation(fields: [guildId], references: [id])
}

model AutoResponse {
  id       Int    @id @default(autoincrement())
  guildId  String
  trigger  String
  response String
  guild    Guild  @relation(fields: [guildId], references: [id])
}

model ReactionRole {
  id        Int    @id @default(autoincrement())
  guildId   String
  messageId String
  emoji     String
  roleId    String
  guild     Guild  @relation(fields: [guildId], references: [id])
}

model Giveaway {
  id              Int             @id @default(autoincrement())
  guildId         String
  channelId       String
  messageId       String          @unique
  prize           String
  winnersCount    Int
  endTime         DateTime
  reqRoleId       String?
  reqInvites      Int             @default(0)
  reqMessageCount Int             @default(0)
  reqLevel        Int             @default(0)
  isActive        Boolean         @default(true)
  hostId          String
  guild           Guild           @relation(fields: [guildId], references: [id])
  entries         GiveawayEntry[]
}

model GiveawayEntry {
  id         Int      @id @default(autoincrement())
  giveawayId Int
  userId     String
  giveaway   Giveaway @relation(fields: [giveawayId], references: [id])

  @@unique([giveawayId, userId])
}

model Birthday {
  id      Int    @id @default(autoincrement())
  guildId String
  userId  String
  day     Int
  month   Int
  year    Int?

  @@unique([guildId, userId])
}

model CustomRole {
  id      Int    @id @default(autoincrement())
  guildId String
  userId  String
  roleId  String

  @@unique([guildId, userId])
}

model DjRole {
  id      Int    @id @default(autoincrement())
  guildId String
  roleId  String
  guild   Guild  @relation(fields: [guildId], references: [id])

  @@unique([guildId, roleId])
}

model Playlist {
  id      Int     @id @default(autoincrement())
  userId  String
  name    String
  guildId String?
  guild   Guild?  @relation(fields: [guildId], references: [id])
  tracks  Track[]

  @@unique([userId, name])
}

model Track {
  id         Int      @id @default(autoincrement())
  playlistId Int
  encoded    String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
}

model Confession {
  id        Int      @id @default(autoincrement())
  guildId   String
  number    Int
  userId    String
  userTag   String
  content   String
  createdAt DateTime @default(now())

  @@unique([guildId, number])
}

model Afk {
  id        Int          @id @default(autoincrement())
  userId    String       @unique
  reason    String       @default("AFK")
  timestamp DateTime     @default(now())
  mentions  AfkMention[]
}

model AfkMention {
  id        Int      @id @default(autoincrement())
  afkId     Int
  userId    String
  userTag   String
  guildId   String
  channelId String
  messageId String
  createdAt DateTime @default(now())
  afk       Afk      @relation(fields: [afkId], references: [id], onDelete: Cascade)
}

model TicketConfig {
  id             Int     @id @default(autoincrement())
  guildId        String
  panelId        String
  name           String
  description    String  @default("Click the button below to open a ticket.")
  categoryId     String
  supportRoleId  String
  channelId      String?
  messageId      String?
  welcomeMessage String? @default("Hello {user}, welcome to your support ticket. Our staff will be with you shortly.")

  @@unique([guildId, panelId])
}

model Ticket {
  id         Int      @id @default(autoincrement())
  guildId    String
  channelId  String   @unique
  userId     String
  claimantId String?
  status     String   @default("OPEN")
  openedAt   DateTime @default(now())
}

model VoiceConfig {
  id              Int     @id @default(autoincrement())
  guildId         String  @unique
  createChannelId String
  categoryId      String
  panelChannelId  String?
  panelMessageId  String?
}

model TempVoice {
  id        Int      @id @default(autoincrement())
  guildId   String
  channelId String   @unique
  ownerId   String
  isLocked  Boolean  @default(false)
  isHidden  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Suggestion {
  id          Int              @id @default(autoincrement())
  guildId     String
  messageId   String           @unique
  authorId    String
  content     String
  isAnonymous Boolean          @default(false)
  createdAt   DateTime         @default(now())
  guild       Guild            @relation(fields: [guildId], references: [id])
  votes       SuggestionVote[]
}

model SuggestionVote {
  id           Int        @id @default(autoincrement())
  suggestionId Int
  userId       String
  type         String
  suggestion   Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  @@unique([suggestionId, userId])
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  guildId     String
  type        String
  event       String
  status      String   @default("INFO")
  executorId  String?
  executorTag String?
  targetId    String?
  targetName  String?
  details     String?
  createdAt   DateTime @default(now())
  guild       Guild    @relation("GuildToAuditLog", fields: [guildId], references: [id])

  @@index([guildId, executorId, type])
}

model UserConfig {
  id           Int      @id @default(autoincrement())
  userId       String   @unique
  snipeOptOut  Boolean  @default(false)
}

model GiveawayBlacklist {
  id         Int      @id @default(autoincrement())
  guildId    String
  userId     String
  
  @@unique([guildId, userId])
}

model GiveawayBonusEntry {
  id         Int      @id @default(autoincrement())
  guildId    String
  targetId   String 
  type       String 
  entries    Int      @default(1)

  @@unique([guildId, targetId])
}

model TicketPanelOption {
  id             Int     @id @default(autoincrement())
  guildId        String
  panelId        String
  label          String
  description    String?
  emoji          String?
  categoryId     String
  supportRoleId  String
  welcomeMessage String? @default("Hello {user}, welcome to your support ticket.")
  
  @@index([guildId, panelId])
}

model BackroomHistory {
  id         Int      @id @default(autoincrement())
  guildId    String
  userId     String
  roleIds    String   
  timestamp  DateTime @default(now())

  @@unique([guildId, userId])
}

model StarboardMessage {
  id                 Int      @id @default(autoincrement())
  guildId            String
  originalMessageId  String   @unique
  starboardMessageId String
  starCount          Int      @default(0)

  @@index([guildId, originalMessageId])
}
